  - m_Id: 93
    m_Localized: "\u0416\u0430\u0437\u044B\u043B\u0443\u0443\u043C\u0434\u0443 \u043A\u0430\u043D\u0442\u0438\u043F
      \u0436\u043E\u043A\u043A\u043E \u0447\u044B\u0433\u0430\u0440\u0441\u0430\u043C
      \u0431\u043E\u043B\u043E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 94
    m_Localized: "\u0411\u0443\u043B \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043D\u0443\u043D
      \u0436\u0430\u0437\u044B\u043B\u0443\u0443 \u043C\u04AF\u043C\u043A\u04AF\u043D\u0447\u04AF\u043B\u04AF\u0433\u04AF
      \u0431\u0430\u0440. \"Lalafun Baby Games\" \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u0441\u0443
      \u0431\u0430\u0440\u0434\u044B\u043A \u043C\u0430\u0437\u043C\u0443\u043D\u0434\u0443\u043D
      \u0436\u0430\u043D\u0430 \u043A\u0443\u0440\u0430\u043B\u0434\u0430\u0440\u0434\u044B\u043D
      \u043A\u0443\u043B\u043F\u0443\u0441\u0443\u043D \u0430\u0447\u0443\u0443 \u04AF\u0447\u04AF\u043D
      \u0436\u0430\u0437\u044B\u043B\u0443\u0443\u043D\u0443 \u0442\u0430\u043B\u0430\u043F
      \u043A\u044B\u043B\u0430\u0442. \u0416\u0430\u0437\u044B\u043B\u0443\u0443\u043D\u0443
      \u043A\u0430\u043C\u0442\u044B\u0433\u0430\u043D \u0431\u0430\u0448\u043A\u0430
      \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440\u0443\u0431\u0443\u0437
      \u04AF\u0447\u04AF\u043D, \u0436\u0430\u0437\u044B\u043B\u0443\u0443\u04A3\u0443\u0437\u0434\u0443
      \u0436\u043E\u043A\u043A\u043E \u0447\u044B\u0433\u0430\u0440\u0443\u0443 \u04AF\u0447\u04AF\u043D
      \u0431\u0443\u043B \u043D\u0443\u0441\u043A\u0430\u043C\u0430\u043B\u0430\u0440\u0434\u044B
      \u0430\u0442\u043A\u0430\u0440\u044B\u04A3\u044B\u0437:\n1. Google Play \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u0441\u0443\u043D
      \u0430\u0447\u044B\u04A3\u044B\u0437.\n2. \u0416\u043E\u0433\u043E\u0440\u043A\u0443
      \u043E\u04A3 \u0431\u0443\u0440\u0447\u0442\u0430\u0433\u044B \u043F\u0440\u043E\u0444\u0438\u043B\u044C
      \u0441\u04E9\u043B\u04E9\u043A\u04E9\u0442\u04AF\u043D \u0442\u0430\u043F\u0442\u0430\u04A3\u044B\u0437.\n3.
      \"\u0422\u04E9\u043B\u04E9\u043C\u0434\u04E9\u0440 \u0436\u0430\u043D\u0430
      \u0436\u0430\u0437\u044B\u043B\u0443\u0443\u043B\u0430\u0440\", \u0430\u043D\u0434\u0430\u043D
      \u0441\u043E\u04A3 \"\u0416\u0430\u0437\u044B\u043B\u0443\u0443\u043B\u0430\u0440\"
      \u0431\u04E9\u043B\u04AF\u043C\u04AF\u043D\u04E9 \u04E9\u0442\u04AF\u04A3\u04AF\u0437.\n4.
      \u0421\u0438\u0437 \u0436\u043E\u043A\u043A\u043E \u0447\u044B\u0433\u0430\u0440\u0443\u0443\u043D\u0443
      \u043A\u0430\u0430\u043B\u0430\u0433\u0430\u043D \u0436\u0430\u0437\u044B\u043B\u0443\u0443\u043D\u0443
      \u0442\u0430\u043D\u0434\u0430\u04A3\u044B\u0437.\n5. \"\u0416\u0430\u0437\u044B\u043B\u0443\u0443\u043D\u0443
      \u0436\u043E\u043A\u043A\u043E \u0447\u044B\u0433\u0430\u0440\u0443\u0443\"
      \u0431\u0430\u0441\u043A\u044B\u0447\u044B\u043D \u0442\u0430\u043F\u0442\u0430\u04A3\u044B\u0437.\n6.
      \u041A\u04E9\u0440\u0441\u04E9\u0442\u043C\u04E9\u043B\u04E9\u0440\u0434\u04AF
      \u0430\u0442\u043A\u0430\u0440\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 95
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u04A3\u0443\u0437
      \u0431\u0438\u0440 \u0436\u043E\u043B\u043A\u0443 \u0442\u04E9\u043B\u04E9\u043C
      \u0436\u0435 \u0436\u0430\u0437\u044B\u043B\u0443\u0443 \u043A\u0430\u0442\u0430\u0440\u044B
      \u0436\u0435\u0442\u043A\u0438\u043B\u0438\u043A\u0442\u04AF\u04AF\u0431\u04AF?"
    m_Metadata:
      m_Items: []
  - m_Id: 96
    m_Localized: "\u0411\u0443\u043B \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E
      - \"Lalafun Baby Games\" \u0430\u0439 \u0441\u0430\u0439\u044B\u043D \u0436\u0435
      \u0436\u044B\u043B\u0434\u044B\u043A \u0436\u0430\u0437\u044B\u043B\u0443\u0443\u043D\u0443
      \u0441\u0443\u043D\u0443\u0448 \u043A\u044B\u043B\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 97
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u04A3\u0443\u0437\u0434\u0443
      \u043A\u043E\u043B\u0434\u043E\u043D\u0443\u0443 \u04AF\u0447\u04AF\u043D \u0441\u0438\u0437\u0433\u0435
      \u0430\u043A\u0442\u0438\u0432\u0434\u04AF\u04AF \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442
      \u0431\u0430\u0439\u043B\u0430\u043D\u044B\u0448\u044B \u043A\u0435\u0440\u0435\u043A\u043F\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 98
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E \u0434\u04AF\u043A\u04E9\u043D\u0434\u04E9\u0440\u04AF\u043D\u04E9\u043D
      \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440\u0443\u0431\u0443\u0437\u0434\u0443
      \u0436\u04AF\u043A\u0442\u04E9\u043F \u0430\u043B\u0443\u0443 \u0436\u0430\u043D\u0430
      \u043E\u0440\u043D\u043E\u0442\u0443\u0443 \u04AF\u0447\u04AF\u043D \u0430\u043A\u0442\u0438\u0432\u0434\u04AF\u04AF
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0431\u0430\u0439\u043B\u0430\u043D\u044B\u0448\u044B
      \u0442\u0430\u043B\u0430\u043F \u043A\u044B\u043B\u044B\u043D\u0430\u0442.
      \u0411\u0438\u0440\u043E\u043A, \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043D\u0443
      \u0442\u04AF\u0437\u043C\u04E9\u0433\u04AF\u04A3\u04AF\u0437\u0433\u04E9 \u043E\u0440\u043D\u043E\u0442\u043A\u043E\u043D\u0434\u043E\u043D
      \u043A\u0438\u0439\u0438\u043D, \u0441\u0438\u0437 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0442\u0435\u043D
      \u0430\u0436\u044B\u0440\u0430\u0442\u044B\u043F, \u0430\u043D\u044B \u043A\u043E\u043B\u0434\u043E\u043D\u0443\u0443\u043D\u0443
      \u0443\u043B\u0430\u043D\u0442\u0430 \u0430\u043B\u0430\u0441\u044B\u0437.
      \u04E8\u0437\u0433\u04E9\u0447\u04E9 \u0443\u0447\u0443\u0440\u043B\u0430\u0440:
      \u041E\u044E\u043D\u0434\u0443\u043D \u0436\u04AF\u0440\u04AF\u0448\u04AF\u043D
      \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0434\u043E\u0448\u0442\u0443\u0440\u0443\u0443,
      \u0436\u0430\u04A3\u044B\u0440\u0442\u0443\u0443\u043B\u0430\u0440\u0434\u044B
      \u0430\u043B\u0443\u0443 \u0436\u0435 \u0436\u0430\u04A3\u044B \u043C\u0430\u0437\u043C\u0443\u043D\u0434\u0443
      \u0430\u043B\u0443\u0443 \u04AF\u0447\u04AF\u043D \u043A\u044D\u044D \u0431\u0438\u0440
      \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440\u0443\u0431\u0443\u0437
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0431\u0430\u0439\u043B\u0430\u043D\u044B\u0448\u044B\u043D
      \u0442\u0430\u043B\u0430\u043F \u043A\u044B\u043B\u044B\u0448\u044B \u043C\u04AF\u043C\u043A\u04AF\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 99
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440\u0443\u04A3\u0443\u0437\u0434\u0430
      \u0436\u0430\u0440\u043D\u0430\u043C\u0430\u043B\u0430\u0440 \u0431\u0430\u0440\u0431\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 100
    m_Localized: "\u0411\u0438\u0437\u0434\u0438\u043D \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440
      \u0442\u043E\u043B\u0443\u0433\u0443 \u043C\u0435\u043D\u0435\u043D \u0436\u0430\u0440\u043D\u0430\u043C\u0430\u0441\u044B\u0437.
      \u0410\u0442\u0430-\u044D\u043D\u0435\u043D\u0438\u043D \u043A\u04E9\u0437\u04E9\u043C\u04E9\u043B\u04AF
      \u043C\u0435\u043D\u0435\u043D \u043A\u043E\u0440\u0433\u043E\u043B\u0433\u043E\u043D
      \"\u0411\u0430\u0448\u043A\u0430 \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440\"
      \u0431\u04E9\u043B\u04AF\u043C\u04AF \u0433\u0430\u043D\u0430 \u0431\u0430\u0440,
      \u0431\u0443\u043B \u0431\u0430\u043B\u0434\u0430\u0440 \u04AF\u0447\u04AF\u043D
      \u0436\u0435\u0442\u043A\u0438\u043B\u0438\u043A\u0441\u0438\u0437. \u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043D\u0443
      \u0438\u0448\u043A\u0435 \u043A\u0438\u0440\u0433\u0438\u0437\u04AF\u04AF\u0434\u04E9\u043D
      \u043C\u0443\u0440\u0443\u043D \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0442\u0435\u043D
      \u0430\u0436\u044B\u0440\u0430\u0442\u044B\u043F, \u0431\u0443\u043B \u0431\u04E9\u043B\u04AF\u043C\u0434\u04AF
      \u04E9\u0447\u04AF\u0440\u04E9 \u0430\u043B\u0430\u0441\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 101
    m_Localized: "\u0422\u0438\u0440\u043A\u0435\u043C\u0435 \u0431\u0435\u043A\u0435\u0440\u0431\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 102
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043D\u0443 \u0436\u04AF\u043A\u0442\u04E9\u043F
      \u0430\u043B\u0443\u0443 \u0436\u0430\u043D\u0430 \u043A\u043E\u043B\u0434\u043E\u043D\u0443\u0443
      \u0430\u043A\u044B\u0441\u044B\u0437. \u0410\u043B \u0430\u0440 \u043A\u0430\u043D\u0434\u0430\u0439
      \u043E\u044E\u043D\u0434\u0430\u0440\u0434\u044B, \u0432\u0438\u0434\u0435\u043E\u043B\u043E\u0440\u0434\u0443,
      \u0431\u043E\u0451\u043A \u0431\u0430\u0440\u0430\u043A\u0447\u0430\u043B\u0430\u0440\u044B\u043D
      \u0436\u0430\u043D\u0430 \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F\u043B\u0430\u0440\u0434\u044B
      \u043A\u0430\u043C\u0442\u044B\u0439\u0442. \u041A\u043E\u0448\u0443\u043C\u0447\u0430
      \u043C\u0430\u0437\u043C\u0443\u043D\u0434\u0443 \u043A\u043E\u0448\u0443\u043C\u0447\u0430
      \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u0434\u043E\u0433\u0443 \u0442\u043E\u043F\u0442\u043E\u043C\u0434\u043E\u0440
      \u0430\u0440\u043A\u044B\u043B\u0443\u0443 \u0441\u0430\u0442\u044B\u043F \u0430\u043B\u0441\u0430
      \u0431\u043E\u043B\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 103
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E \u0431\u0430\u043B\u0434\u0430\u0440
      \u04AF\u0447\u04AF\u043D \u043A\u043E\u043E\u043F\u0441\u0443\u0437\u0431\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 104
    m_Localized: "\u041E\u043E\u0431\u0430, \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E
      \u043A\u043E\u043E\u043F\u0441\u0443\u0437\u0434\u0443\u043A \u0447\u0430\u0440\u0430\u043B\u0430\u0440\u044B
      \u043A\u0430\u0442\u0443\u0443 \u0441\u0430\u043A\u0442\u0430\u043B\u0433\u0430\u043D
      \u0431\u0430\u043B\u0434\u0430\u0440 \u04AF\u0447\u04AF\u043D \u0430\u0442\u0430\u0439\u044B\u043D
      \u0438\u0448\u0442\u0435\u043B\u0438\u043F \u0447\u044B\u043A\u043A\u0430\u043D.
      \u0410\u043B \u044D\u0447 \u043A\u0430\u043D\u0434\u0430\u0439 \u0436\u0430\u0440\u043D\u0430\u043C\u0430\u043D\u044B,
      \u044D\u0447 \u043A\u0430\u043D\u0434\u0430\u0439 \u0442\u044B\u0448\u043A\u044B
      \u0448\u0438\u043B\u0442\u0435\u043C\u0435\u043B\u0435\u0440\u0434\u0438 \u043A\u0430\u043C\u0442\u044B\u0431\u0430\u0439\u0442
      \u0436\u0430\u043D\u0430 \u0436\u0435\u043A\u0435 \u043C\u0430\u0430\u043B\u044B\u043C\u0430\u0442\u0442\u0430\u0440\u0434\u044B
      \u0447\u043E\u0433\u0443\u043B\u0442\u043F\u0430\u0439\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 105
    m_Localized: "\u0416\u0430\u04A3\u044B \u043C\u0430\u0437\u043C\u0443\u043D \u043A\u0430\u043D\u0447\u0430\u043B\u044B\u043A
      \u043A\u04E9\u043F \u043A\u043E\u0448\u0443\u043B\u0430\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 106
    m_Localized: "\u0416\u0430\u04A3\u044B \u043E\u044E\u043D\u0434\u0430\u0440,
      \u0432\u0438\u0434\u0435\u043E\u043B\u043E\u0440, \u0431\u043E\u0451\u0447\u0443
      \u0431\u0430\u0440\u0430\u043A\u0442\u0430\u0440 \u200B\u200B\u0436\u0430\u043D\u0430
      \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F\u043B\u0430\u0440 \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043D\u0443
      \u0431\u0430\u043B\u0430\u04A3\u044B\u0437 \u04AF\u0447\u04AF\u043D \u043A\u044B\u0437\u044B\u043A\u0442\u0443\u0443
      \u043A\u044B\u043B\u044B\u043F \u0442\u0443\u0440\u0443\u0443 \u04AF\u0447\u04AF\u043D
      \u0434\u0430\u0439\u044B\u043C\u0430 \u043A\u043E\u0448\u0443\u043B\u0443\u043F
      \u0442\u0443\u0440\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 107
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E \u043A\u0430\u0442\u044B\u043F
      \u043A\u0430\u043B\u0441\u0430 \u0436\u0435 \u043A\u04E9\u0439\u0433\u04E9\u0439
      \u0436\u0430\u0440\u0430\u043B\u0441\u0430 \u044D\u043C\u043D\u0435 \u043A\u044B\u043B\u044B\u0448\u044B\u043C
      \u043A\u0435\u0440\u0435\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 108
    m_Localized: "\u041A\u044B\u0439\u044B\u043D\u0447\u044B\u043B\u044B\u043A\u043A\u0430
      \u043A\u0430\u0431\u044B\u043B\u044B\u043F \u0436\u0430\u0442\u0441\u0430\u04A3\u044B\u0437,
      {supportLink} \u0434\u0430\u0440\u0435\u0433\u0438 \u0431\u043E\u044E\u043D\u0447\u0430
      \u043A\u043E\u043B\u0434\u043E\u043E \u0442\u043E\u0431\u0443\u0431\u0443\u0437\u0433\u0430
      \u043A\u0430\u0439\u0440\u044B\u043B\u0441\u0430\u04A3\u044B\u0437 \u0431\u043E\u043B\u043E\u0442
      \u0436\u0435 {websiteLink} \u0434\u0430\u0440\u0435\u0433\u0438\u043D\u0434\u0435\u0433\u0438
      \u0436\u0430\u0440\u0434\u0430\u043C \u0431\u043E\u0440\u0431\u043E\u0440\u0443\u0431\u0443\u0437\u0433\u0430
      \u043A\u0430\u0439\u0440\u044B\u043B\u0441\u0430\u04A3\u044B\u0437 \u0431\u043E\u043B\u043E\u0442.
      \u0411\u0438\u0437 \u0436\u0430\u0440\u0434\u0430\u043C \u0431\u0435\u0440\u04AF\u04AF
      \u04AF\u0447\u04AF\u043D \u0431\u0443\u043B \u0436\u0435\u0440\u0434\u0435\u0431\u0438\u0437!"
    m_Metadata:
      m_Items: []
