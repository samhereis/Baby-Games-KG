  - m_Id: 88
    m_Localized: "\u0421\u0443\u0440\u0430\u043D\u044B\u0447, \u0431\u0443\u043B
      \u043A\u0430\u0434\u0430\u043C\u0434\u0430\u0440\u0434\u044B \u0430\u0442\u043A\u0430\u0440\u044B\u04A3\u044B\u0437:\n1.
      \u0421\u0430\u0442\u044B\u043F \u0430\u043B\u0443\u0443 \u04AF\u0447\u04AF\u043D
      \u043A\u043E\u043B\u0434\u043E\u043D\u0443\u043B\u0433\u0430\u043D \u044D\u0441\u0435\u043F\u0442\u0438
