  - m_Id: 56
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E \u0434\u04AF\u043A\u04E9\u043D\u0434\u04E9\u0440\u04AF\u043D\u04E9\u043D
      \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440\u0443\u0431\u0443\u0437\u0434\u0443
      \u0436\u04AF\u043A\u0442\u04E9\u043F \u0430\u043B\u0443\u0443 \u0436\u0430\u043D\u0430
      \u043E\u0440\u043D\u043E\u0442\u0443\u0443 \u04AF\u0447\u04AF\u043D \u0430\u043A\u0442\u0438\u0432\u0434\u04AF\u04AF
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0431\u0430\u0439\u043B\u0430\u043D\u044B\u0448\u044B
      \u0442\u0430\u043B\u0430\u043F \u043A\u044B\u043B\u044B\u043D\u0430\u0442.
      \u0411\u0438\u0440\u043E\u043A, \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043D\u0443
      \u0442\u04AF\u0437\u043C\u04E9\u0433\u04AF\u04A3\u04AF\u0437\u0433\u04E9 \u043E\u0440\u043D\u043E\u0442\u043A\u043E\u043D\u0434\u043E\u043D
      \u043A\u0438\u0439\u0438\u043D, \u0441\u0438\u0437 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0442\u0435\u043D
      \u0430\u0436\u044B\u0440\u0430\u0442\u044B\u043F, \u0430\u043D\u044B \u043A\u043E\u043B\u0434\u043E\u043D\u0443\u0443\u043D\u0443
      \u0443\u043B\u0430\u043D\u0442\u0430 \u0430\u043B\u0430\u0441\u044B\u0437.
      \u04E8\u0437\u0433\u04E9\u0447\u04E9 \u0443\u0447\u0443\u0440\u043B\u0430\u0440:
      \u041E\u044E\u043D\u0434\u0443\u043D \u0436\u04AF\u0440\u04AF\u0448\u04AF\u043D
      \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0434\u043E\u0448\u0442\u0443\u0440\u0443\u0443,
      \u0436\u0430\u04A3\u044B\u0440\u0442\u0443\u0443\u043B\u0430\u0440\u0434\u044B
      \u0430\u043B\u0443\u0443 \u0436\u0435 \u0436\u0430\u04A3\u044B \u043C\u0430\u0437\u043C\u0443\u043D\u0434\u0443
      \u0430\u043B\u0443\u0443 \u04AF\u0447\u04AF\u043D \u043A\u044D\u044D \u0431\u0438\u0440
      \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440\u0443\u0431\u0443\u0437
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0431\u0430\u0439\u043B\u0430\u043D\u044B\u0448\u044B\u043D
      \u0442\u0430\u043B\u0430\u043F \u043A\u044B\u043B\u044B\u0448\u044B \u043C\u04AF\u043C\u043A\u04AF\u043D."
