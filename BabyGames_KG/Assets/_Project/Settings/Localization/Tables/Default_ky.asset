  m_TableData:
  - m_Id: 22
    m_Localized: "\u0422\u043E\u043B\u0443\u043A \u043C\u04AF\u043C\u043A\u04AF\u043D\u0447\u04AF\u043B\u04AF\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "\u0411\u0438\u0437 \u0436\u04E9\u043D\u04AF\u043D\u0434\u04E9"
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Saratan Animations \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\u0441\u044B\u043D\u044B\u043D
      \u0436\u0430\u043B\u044B\u043D\u0434\u0443\u0443 \u0430\u0434\u0438\u0441\u0442\u0435\u0440\u0438
      \u043C\u0435\u043D\u0435\u043D \u0442\u0430\u0430\u043D\u044B\u0448\u044B\u04A3\u044B\u0437.
      \u0411\u0438\u0437\u0434\u0438\u043D \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u0431\u0430\u043B\u0434\u0430\u0440 \u04AF\u0447\u04AF\u043D \u0431\u0438\u043B\u0438\u043C
      \u0431\u0435\u0440\u04AF\u04AF\u0447\u04AF \u0436\u0430\u043D\u0430 \u043A\u04E9\u04A3\u04AF\u043B
      \u0430\u0447\u0443\u0443\u0447\u0443 \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440\u0434\u0443
      \u0438\u0448\u0442\u0435\u043F \u0447\u044B\u0433\u0443\u0443\u0433\u0430 \u0430\u0440\u043D\u0430\u043B\u0433\u0430\u043D
      \u0447\u044B\u0433\u0430\u0440\u043C\u0430\u0447\u044B\u043B \u0430\u0434\u0430\u043C\u0434\u0430\u0440\u0434\u044B\u043D
      \u0442\u043E\u0431\u0443. \u0411\u0438\u0437\u0434\u0438\u043D \u0443\u0447\u0443\u0440\u0434\u0430\u0433\u044B
      \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u0431\u0443\u0437, Lalafun
      Baby Games, \u043A\u044B\u0437\u044B\u043A\u0442\u0443\u0443 \u0436\u0430\u043D\u0430
      \u0438\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u0434\u04AF\u04AF
      \u0438\u0448-\u0447\u0430\u0440\u0430\u043B\u0430\u0440 \u0430\u0440\u043A\u044B\u043B\u0443\u0443
      \u0436\u0430\u0448 \u0430\u043A\u044B\u043B\u0434\u0430\u0440\u0434\u044B \u0448\u044B\u043A\u0442\u0430\u043D\u0434\u044B\u0440\u0430\u0442.
      \u0414\u04AF\u0439\u043D\u04E9 \u0436\u04AF\u0437\u04AF\u043D\u0434\u04E9\u0433\u04AF
      \u0431\u0430\u043B\u0434\u0430\u0440 \u04AF\u0447\u04AF\u043D \u043A\u0443\u0431\u0430\u043D\u044B\u0447\u0442\u0443\u0443
      \u0431\u0438\u043B\u0438\u043C \u0431\u0435\u0440\u04AF\u04AF \u0442\u0430\u0436\u0440\u044B\u0439\u0431\u0430\u0441\u044B\u043D
      \u0442\u04AF\u0437\u04AF\u04AF \u04AF\u0447\u04AF\u043D \u0431\u0438\u0437\u0434\u0438\u043D
      \u0441\u0430\u044F\u043A\u0430\u0442\u044B\u0431\u044B\u0437\u0433\u0430 \u043A\u043E\u0448\u0443\u043B\u0443\u04A3\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "\u042D\u043C\u043D\u0435 \u04AF\u0447\u04AF\u043D \u0430\u0442\u0430-\u044D\u043D\u0435\u043B\u0435\u0440
      \u0431\u0438\u0437\u0433\u0435 \u0438\u0448\u0435\u043D\u0438\u0448\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "\u0416\u0430\u0440\u043D\u0430\u043C\u0430\u043B\u0430\u0440 \u0436\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "\u0411\u0438\u0437\u0434\u0438\u043D \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440
      \u0436\u0430\u0440\u043D\u0430\u043C\u0430\u0441\u044B\u0437, \u0431\u0430\u043B\u0430\u04A3\u044B\u0437
      \u04AF\u0447\u04AF\u043D \u043A\u043E\u043E\u043F\u0441\u0443\u0437 \u0436\u0430\u043D\u0430
      \u04AF\u0437\u0433\u04AF\u043B\u0442\u04AF\u043A\u0441\u04AF\u0437 \u043E\u043A\u0443\u0443
      \u0442\u0430\u0436\u0440\u044B\u0439\u0431\u0430\u0441\u044B\u043D \u043A\u0430\u043C\u0441\u044B\u0437
      \u043A\u044B\u043B\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "\u041A\u043E\u043E\u043F\u0441\u0443\u0437 \u043C\u0430\u0437\u043C\u0443\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "\u0411\u0438\u0437\u0434\u0438\u043D \u043C\u0430\u0437\u043C\u0443\u043D
      \u0431\u0430\u043B\u0434\u0430\u0440 \u04AF\u0447\u04AF\u043D \u043A\u043E\u043E\u043F\u0441\u0443\u0437
      \u0436\u0430\u043D\u0430 \u044B\u043B\u0430\u0439\u044B\u043A\u0442\u0443\u0443
      \u0431\u043E\u043B\u0443\u0448\u0443 \u04AF\u0447\u04AF\u043D \u043A\u044B\u043B\u0434\u0430\u0442
      \u0438\u0448\u0442\u0435\u043B\u0438\u043F \u0447\u044B\u043A\u043A\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "\u041C\u0435\u043A\u0442\u0435\u043F\u043A\u0435 \u0447\u0435\u0439\u0438\u043D\u043A\u0438
      \u0431\u0430\u043B\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "\u041D\u0430\u0448\u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F
      \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u044B
      \u0434\u043B\u044F \u0434\u0435\u0442\u0435\u0439 \u0432 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
      \u043E\u0442 2 \u0434\u043E 5 \u043B\u0435\u0442, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442
      \u0438\u0445 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0434\u043B\u044F
      \u0434\u043E\u0448\u043A\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "\u0422\u0438\u0440\u043A\u0435\u043C\u0435\u043B\u0435\u0440\u0434\u0435
      \u043B\u043E\u043A\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "\u0411\u0438\u0437\u0434\u0438\u043D \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440
      \u0431\u0438\u0440 \u043D\u0435\u0447\u0435 \u0442\u0438\u043B\u0434\u0438
      \u043A\u043E\u043B\u0434\u043E\u043F, \u0430\u043B\u0430\u0440\u0434\u044B
      \u0434\u04AF\u0439\u043D\u04E9 \u0436\u04AF\u0437\u04AF\u043D\u0434\u04E9\u0433\u04AF
      \u0431\u0430\u043B\u0434\u0430\u0440 \u04AF\u0447\u04AF\u043D \u0436\u0435\u0442\u043A\u0438\u043B\u0438\u043A\u0442\u04AF\u04AF
      \u043A\u044B\u043B\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u0434\u04AF\u04AF
      \u043E\u043A\u0443\u0442\u0443\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "\u0411\u0438\u0437\u0434\u0438\u043D \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440
      \u0438\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u0434\u04AF\u04AF
      \u0436\u0430\u043D\u0430 \u0431\u0438\u043B\u0438\u043C \u0431\u0435\u0440\u04AF\u04AF\u0447\u04AF
      \u0431\u043E\u043B\u0443\u043F \u0441\u0430\u043D\u0430\u043B\u0430\u0442,
      \u0430\u043B\u0430\u0440 \u043C\u0430\u0430\u043D\u0438\u043B\u04AF\u04AF \u043A\u04E9\u043D\u0434\u04AF\u043C\u0434\u04E9\u0440\u0434\u04AF
      \u04E9\u043D\u04AF\u043A\u0442\u04AF\u0440\u04AF\u04AF\u0433\u04E9 \u0436\u0430\u043D\u0430
      \u04AF\u0439\u0440\u04E9\u0442\u04AF\u04AF\u0433\u04E9 \u043A\u04E9\u043C\u04E9\u043A\u0442\u04E9\u0448\u04E9\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "\u0411\u0435\u043A\u0435\u0440 \u043E\u044E\u043D\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "\u0411\u0438\u0437\u0434\u0438\u043D \u043E\u044E\u043D\u0434\u0430\u0440\u0434\u044B
      \u0431\u0435\u043A\u0435\u0440 \u043A\u043E\u043B\u0434\u043E\u043D\u0443\u043F
      \u043A\u04E9\u0440\u04AF\u04A3\u04AF\u0437 \u0436\u0430\u043D\u0430 \u0431\u0430\u043B\u0430\u04A3\u044B\u0437\u0434\u044B\u043D
      \u04E9\u0441\u04AF\u0448\u04AF\u043D\u04E9 \u0436\u0430\u0440\u0434\u0430\u043C
      \u0431\u0435\u0440\u0438\u04A3\u0438\u0437. \u041A\u044B\u0437\u044B\u043A\u0442\u0443\u0443
      \u0436\u0430\u043D\u0430 \u0431\u0438\u043B\u0438\u043C \u0431\u0435\u0440\u04AF\u04AF\u0447\u04AF
      \u0438\u0448-\u0447\u0430\u0440\u0430\u043B\u0430\u0440 \u0434\u04AF\u0439\u043D\u04E9\u0441\u04AF\u043D
      \u0430\u0447\u044B\u04A3\u044B\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "\u0411\u0438\u0437\u0434\u0438\u043D \u043A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043B\u043E\u0440
      \u0441\u0438\u0437\u0433\u0435 \u0436\u0430\u0433\u0430\u0431\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "\u0421\u0443\u0440\u0430\u043D\u044B\u0447, \u0431\u0438\u0437\u0433\u0435
      \u0436\u0430\u043A\u0448\u044B\u0440\u0430\u0430\u043A \u0431\u043E\u043B\u0443\u0443\u0433\u0430
      \u0436\u0430\u0440\u0434\u0430\u043C \u0431\u0435\u0440\u0438\u04A3\u0438\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "\u0411\u0438\u0437\u0433\u0435 \u0431\u0430\u0430 \u0431\u0435\u0440\u0438\u04A3\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: FAQ
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "\u0421\u0443\u0440\u043E\u043E\u043B\u043E\u0440\u0443\u04A3\u0443\u0437
      \u0431\u043E\u043B\u0441\u043E, \u0431\u0438\u0437\u0433\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0434\u0443\u043A
      \u043A\u0430\u0442 \u0436\u0430\u0437\u044B\u04A3\u044B\u0437: {emailName}"
    m_Metadata:
      m_Items:
      - rid: 8374097529394429952
  - m_Id: 43
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043D\u0443 \u043A\u0430\u043D\u0442\u0438\u043F
      \u0441\u0430\u0442\u044B\u043F \u0430\u043B\u0441\u0430\u043C \u0431\u043E\u043B\u043E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "\u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043D\u0443 \u0438\u0448\u043A\u0435
      \u043A\u0438\u0440\u0433\u0438\u0437\u04AF\u04AF\u0434\u04E9\u043D \u043C\u0443\u0440\u0443\u043D
      \u0436\u0430\u0440\u0430\u043A\u0442\u0443\u0443 \u0442\u04E9\u043B\u04E9\u043C
      \u044B\u043A\u043C\u0430\u0441\u044B \u0436\u0430\u043D\u0430 \u0430\u043A\u0442\u0438\u0432\u0434\u04AF\u04AF
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0431\u0430\u0439\u043B\u0430\u043D\u044B\u0448\u044B
      \u0431\u0430\u0440 \u044D\u043A\u0435\u043D\u0438\u043D \u0442\u0435\u043A\u0448\u0435\u0440\u0438\u04A3\u0438\u0437.
      \u0410\u043D\u0434\u0430\u043D \u043A\u0438\u0439\u0438\u043D, \u0431\u04E9\u0433\u04E9\u0442\u0442\u04E9\u043B\u0433\u04E9\u043D
      \u043C\u0430\u0437\u043C\u0443\u043D\u0434\u0443 \u0442\u0430\u043F\u0442\u0430\u043F,
      \u0430\u0442\u0430-\u044D\u043D\u0435\u043D\u0438\u043D \u043A\u04E9\u0437\u04E9\u043C\u04E9\u043B\u04AF\u043D\u04E9\u043D
      \u04E9\u0442\u04AF\u043F, \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0442\u0443\u0443
      \u0441\u0430\u0442\u044B\u043F \u0430\u043B\u0443\u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0438\u043D
      \u0430\u0442\u043A\u0430\u0440\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: "\u0421\u0430\u0442\u044B\u043F \u0430\u043B\u0443\u0443\u043D\u0443
      \u043A\u0430\u043D\u0442\u0438\u043F \u043A\u0430\u043B\u044B\u0431\u044B\u043D\u0430
      \u043A\u0435\u043B\u0442\u0438\u0440\u04AF\u04AF/\u04E9\u0442\u043A\u04E9\u0440\u04AF\u04AF
      \u043A\u0435\u0440\u0435\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "\u0421\u0443\u0440\u0430\u043D\u044B\u0447, \u0431\u0443\u043B
      \u043A\u0430\u0434\u0430\u043C\u0434\u0430\u0440\u0434\u044B \u0430\u0442\u043A\u0430\u0440\u044B\u04A3\u044B\u0437:\n1.
      \u0421\u0430\u0442\u044B\u043F \u0430\u043B\u0443\u0443 \u04AF\u0447\u04AF\u043D
      \u043A\u043E\u043B\u0434\u043E\u043D\u0443\u043B\u0433\u0430\u043D \u044D\u0441\u0435\u043F\u0442\u0438
      \u043E\u0440\u043D\u043E\u0442\u0443\u04A3\u0443\u0437.\n2. \u0422\u0438\u0440\u043A\u0435\u043C\u0435\u043D\u0438
      \u043E\u0448\u043E\u043B \u043A\u0430\u0442\u0442\u043E\u043E \u044D\u0441\u0435\u0431\u0438
      \u043C\u0435\u043D\u0435\u043D \u0436\u04AF\u043A\u0442\u04E9\u043F \u0430\u043B\u044B\u04A3\u044B\u0437.\n3.
      \u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0431\u0430\u0439\u043B\u0430\u043D\u044B\u0448\u044B\u04A3\u044B\u0437
      \u0438\u0448\u0442\u0435\u0442\u0438\u043B\u0433\u0435\u043D\u0438\u043D \u0442\u0435\u043A\u0448\u0435\u0440\u0438\u04A3\u0438\u0437.\n4.
      \u041A\u043E\u043B\u0434\u043E\u043D\u043C\u043E\u043D\u0443 \u0438\u0448\u043A\u0435
      \u043A\u0438\u0440\u0433\u0438\u0437\u0438\u04A3\u0438\u0437.\n\u042D\u0441\u043A\u0435\u0440\u0442\u04AF\u04AF:
      \u0421\u0430\u0442\u044B\u043F \u0430\u043B\u0443\u0443\u043B\u0430\u0440\u0434\u044B
      \u0431\u0430\u0448\u0442\u0430\u043F\u043A\u044B \u0434\u04AF\u043A\u04E9\u043D\u0434\u04E9
      \u0433\u0430\u043D\u0430 \u043A\u0430\u043B\u044B\u0431\u044B\u043D\u0430 \u043A\u0435\u043B\u0442\u0438\u0440\u04AF\u04AF\u0433\u04E9
