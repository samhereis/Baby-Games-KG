  - m_Id: 92
    m_Localized: "\u0422\u04E9\u043B\u04E9\u043C \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430\u043B\u0430\u0440\u044B
      \u0431\u043E\u044E\u043D\u0447\u0430 \u0431\u0438\u0437\u0434\u0438\u043D \u044B\u0439\u0433\u0430\u0440\u044B\u043C
      \u0443\u043A\u0443\u043A\u0442\u0430\u0440\u044B\u0431\u044B\u0437 \u0436\u043E\u043A.
      \u042D\u0433\u0435\u0440 \u0441\u0438\u0437 Android \u043A\u043E\u043B\u0434\u043E\u043D\u0441\u043E\u04A3\u0443\u0437,
      \u0434\u04AF\u043A\u04E9\u043D\u0434\u04AF\u043D \u043A\u0430\u0439\u0442\u0430\u0440\u0443\u0443
      \u0441\u0430\u044F\u0441\u0430\u0442\u044B\u043D \u0430\u0442\u043A\u0430\u0440\u044B\u04A3\u044B\u0437
      \u0436\u0430\u043D\u0430 \u0431\u0430\u0440\u0434\u044B\u043A \u0442\u04E9\u043B\u04E9\u043C
      \u0436\u0435 \u0442\u04E9\u043B\u04E9\u043C\u0434\u04AF \u043A\u0430\u0439\u0442\u0430\u0440\u0443\u0443
      \u043C\u0430\u0441\u0435\u043B\u0435\u043B\u0435\u0440\u0438\u043D \u0447\u0435\u0447\u04AF\u04AF
      \u04AF\u0447\u04AF\u043D Google Play \u043A\u043E\u043B\u0434\u043E\u043E \u0442\u043E\u0431\u0443\u043D\u0430
      \u043A\u0430\u0439\u0440\u044B\u043B\u044B\u04A3\u044B\u0437."
