    m_Localized: "\u0422\u0438\u043B\u0435\u043A\u043A\u0435 \u043A\u0430\u0440\u0448\u044B,
      Google Play \u04AE\u0439-\u0431\u04AF\u043B\u04E9\u043B\u04AF\u043A \u043A\u0438\u0442\u0435\u043F\u043A\u0430\u043D\u0430\u0441\u044B\u043D\u0434\u0430
