      \u062A\u0637\u0628\u064A\u0642\u0627\u062A\u0643\u0645 \u0639\u0644\u0649 \u0625\u0639\u0644\u0627\u0646\u0627\u062A\u061F\t\u0418\u043C\u0430\u0442
      \u043B\u0438 \u0432\u0430\u0448\u0438\u0442\u0435 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F
