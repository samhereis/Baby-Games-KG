      \u03B4\u03B9\u03B1\u03C6\u03B7\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2\t\u05DC\u05DC\u05D0
      \u05E4\u05E8\u05E1\u05D5\u05DE\u05D5\u05EA\t\u0915\u094B\u0908 \u0935\u093F\u091C\u094D\u091E\u093E\u092A\u0928
      \u0928\u0939\u0940\u0902\tNincs hirdet\xE9s\tTanpa Iklan\tNessuna pubblicit\xE0\t\u5E83\u544A\u306A\u3057\t\uAD11\uACE0
