      \u05DC\u05E0\u05D5 \u05DC\u05D4\u05E9\u05EA\u05E4\u05E8!\t\u0915\u0943\u092A\u092F\u093E
      \u0939\u092E\u0947\u0902 \u092C\u0947\u0939\u0924\u0930 \u092C\u0928\u093E\u0928\u0947
      \u092E\u0947\u0902 \u092E\u0926\u0926 \u0915\u0930\u0947\u0902!\tK\xE9rem,
