    characterSequence: "\uC804\uCCB4 \uC561\uC138\uC2A4\r\n\uD68C\uC0AC \uC18C\uAC1C\r\nSaratan
      Animations Studio\uB97C \uC774\uB044\uB294 \uC5F4\uC815\uC801\uC778 \uC0AC\uB78C\uB4E4\uC744
      \uB9CC\uB098\uBCF4\uC138\uC694. \uC6B0\uB9AC \uD300\uC740 \uCC3D\uC758\uC801\uC778
      \uC778\uC7AC\uB4E4\uB85C \uAD6C\uC131\uB41C \uB2E4\uC591\uD55C \uADF8\uB8F9\uC73C\uB85C,
      \uC544\uC774\uB4E4\uC744 \uC704\uD55C \uAD50\uC721\uC801\uC774\uACE0 \uC7AC\uBBF8\uC788\uB294
      \uC571\uC744 \uAC1C\uBC1C\uD558\uB294 \uB370 \uC804\uB150\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uD604\uC7AC \uC571\uC778 Lalafun - Mini Games for Kids\uB294 \uC7AC\uBBF8\uC788\uACE0
      \uC0C1\uD638\uC791\uC6A9\uC801\uC778 \uD65C\uB3D9\uC744 \uD1B5\uD574 \uC5B4\uB9B0
      \uB9C8\uC74C\uC5D0 \uC601\uAC10\uC744 \uC90D\uB2C8\uB2E4. \uC804 \uC138\uACC4
      \uC544\uC774\uB4E4\uC744 \uC704\uD55C \uC990\uAC70\uC6B4 \uD559\uC2B5 \uACBD\uD5D8\uC744
      \uCC3D\uC870\uD558\uB294 \uC5EC\uC815\uC5D0 \uD568\uAED8\uD558\uC138\uC694.\r\n\uBD80\uBAA8\uB2D8\uC774
      \uC6B0\uB9AC\uB97C \uC2E0\uB8B0\uD558\uB294 \uC774\uC720\r\n\uAD11\uACE0 \uC5C6\uC74C\r\n\uC6B0\uB9AC\uC758
      \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC740 \uAD11\uACE0\uAC00 \uC5C6\uC73C\uBA70,
      \uC790\uB140\uC5D0\uAC8C \uC548\uC804\uD558\uACE0 \uB04A\uAE40 \uC5C6\uB294
      \uD559\uC2B5 \uACBD\uD5D8\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4.\r\n\uC548\uC804\uD55C
      \uCF58\uD150\uCE20\r\n\uC6B0\uB9AC\uC758 \uCF58\uD150\uCE20\uB294 \uC790\uB140\uC5D0\uAC8C
      \uC548\uC804\uD558\uACE0 \uC801\uD569\uD558\uB2E4\uB294 \uAC83\uC744 \uBCF4\uC7A5\uD558\uAE30
      \uC704\uD574 \uC2E0\uC911\uD558\uAC8C \uC124\uACC4\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uC720\uCE58\uC6D0
      \uC5F0\uB839 \uC5B4\uB9B0\uC774\r\n\uC800\uD76C \uC571\uC740 2\uC138\uC5D0\uC11C
      5\uC138 \uC0AC\uC774\uC758 \uC5B4\uB9B0\uC774\uB97C \uC704\uD574 \uB9CC\uB4E4\uC5B4\uC84C\uC73C\uBA70,
      \uC720\uCE58\uC6D0 \uC5F0\uB839 \uC5B4\uB9B0\uC774\uC5D0\uAC8C \uC801\uD569\uD569\uB2C8\uB2E4.\r\n\uC571
      \uD604\uC9C0\uD654\r\n\uC800\uD76C \uC571\uC740 \uC5EC\uB7EC \uC5B8\uC5B4\uB97C
      \uC9C0\uC6D0\uD558\uC5EC \uC804 \uC138\uACC4 \uC5B4\uB9B0\uC774\uB4E4\uC774
      \uC811\uADFC\uD560 \uC218 \uC788\uB3C4\uB85D \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC778\uD130\uB799\uD2F0\uBE0C
      \uD559\uC2B5\r\n\uC800\uD76C \uC571\uC740 \uC0C1\uD638\uC791\uC6A9\uC801\uC774\uACE0
      \uAD50\uC721\uC801\uC774\uBA70, \uBC1C\uB2EC\uC744 \uCD09\uC9C4\uD558\uACE0
      \uD544\uC218\uC801\uC778 \uAE30\uC220\uC744 \uAC00\uB974\uCE69\uB2C8\uB2E4.\r\n\uBB34\uB8CC
      \uAC8C\uC784\r\n\uBB34\uB8CC\uB85C \uC800\uD76C \uAC8C\uC784\uC744 \uC2DC\uB3C4\uD574
      \uBCF4\uACE0 \uC790\uB140\uC758 \uC131\uC7A5\uC744 \uC9C0\uC6D0\uD558\uC138\uC694.
      \uC7AC\uBBF8\uC788\uACE0 \uAD50\uC721\uC801\uC778 \uD65C\uB3D9\uC758 \uC138\uACC4\uB97C
      \uBC1C\uACAC\uD558\uC138\uC694!\r\n\uC800\uD76C \uC571\uC744 \uC990\uAE30\uACE0
      \uC788\uB098\uC694?\r\n\uC800\uD76C\uAC00 \uB354 \uB098\uC544\uC9C8 \uC218
      \uC788\uB3C4\uB85D \uB3C4\uC640\uC8FC\uC138\uC694!\r\n\uD3C9\uAC00\uD574\uC8FC\uC138\uC694\r\nFAQ\r\n\uC9C8\uBB38\uC774
      \uC788\uC73C\uC2DC\uBA74 \uC800\uD76C\uC5D0\uAC8C \uAE00\uC744 \uB0A8\uACA8\uC8FC\uC138\uC694:
      {emailName}\r\n\uC774 \uC571\uC744 \uC5B4\uB5BB\uAC8C \uAD6C\uB9E4\uD560 \uC218
      \uC788\uB098\uC694?\r\n\uC571\uC744 \uC2DC\uC791\uD558\uAE30 \uC804\uC5D0 \uC720\uD6A8\uD55C
      \uACB0\uC81C \uBC29\uBC95\uACFC \uD65C\uC131 \uC778\uD130\uB137 \uC5F0\uACB0\uC774
      \uC788\uB294\uC9C0 \uD655\uC778\uD558\uC138\uC694. \uADF8\uB7F0 \uB2E4\uC74C
      \uC7A0\uAE34 \uCF58\uD150\uCE20\uB97C \uB204\uB974\uACE0 \uBD80\uBAA8 \uAC8C\uC774\uD2B8\uB97C
      \uD1B5\uACFC\uD55C \uD6C4 \uC77C\uBC18 \uAD6C\uB9E4 \uC808\uCC28\uB97C \uB530\uB974\uC138\uC694.\r\n\uAD6C\uB9E4\uB97C
      \uBCF5\uAD6C/\uC774\uC804\uD558\uB824\uBA74 \uC5B4\uB5BB\uAC8C \uD574\uC57C
      \uD558\uB098\uC694?\r\n\"\uB2E4\uC74C \uB2E8\uACC4\uB97C \uB530\uB974\uC138\uC694:\r\n1.
      \uC6D0\uB798 \uAD6C\uB9E4\uAC00 \uC774\uB8E8\uC5B4\uC9C4 \uACC4\uC815\uC744
      \uC124\uC815\uD558\uC138\uC694.\r\n2. \uD574\uB2F9 \uACC4\uC815\uC744 \uC0AC\uC6A9\uD558\uC5EC
      \uC571\uC744 \uB2E4\uC6B4\uB85C\uB4DC\uD558\uC138\uC694.\r\n3. \uC778\uD130\uB137
      \uC5F0\uACB0\uC774 \uD65C\uC131\uD654\uB418\uC5B4 \uC788\uB294\uC9C0 \uD655\uC778\uD558\uC138\uC694.\r\n4.
      \uC571\uC744 \uC2E4\uD589\uD558\uC138\uC694.\r\n\uCC38\uACE0: \uC778\uC571
      \uAD6C\uB9E4 \uBCF5\uAD6C\uB294 \uC6D0\uB798\uC758 \uC2A4\uD1A0\uC5B4 \uB0B4\uC5D0\uC11C\uB9CC
      \uAC00\uB2A5\uD569\uB2C8\uB2E4.\"\r\nApple Family Sharing \uD504\uB85C\uADF8\uB7A8\uC744
      \uC0AC\uC6A9\uD558\uC5EC \uC571 \uB0B4 \uAD6C\uB9E4\uB97C \uACF5\uC720\uD558\uB824\uBA74
      \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD558\uB098\uC694?\r\n\"Family Sharing \uC124\uC815
      \uBC29\uBC95:\r\n1 - \uC124\uC815\uC744 \uC5FD\uB2C8\uB2E4.\r\n2 - \uC774\uB984\uC744
      \uD0ED\uD569\uB2C8\uB2E4.\r\n3 - \uAC00\uC871 \uACF5\uC720\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4.\r\n4
      - \"\"\uAC00\uC871 \uC124\uC815\"\"\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4.\r\n\uD654\uBA74\uC758
      \uC9C0\uCE68\uC5D0 \uB530\uB77C \uAC00\uC871\uC744 \uC124\uC815\uD558\uACE0
      \uAD6C\uC131\uC6D0\uC744 \uCD08\uB300\uD569\uB2C8\uB2E4.\"\r\n\uC2E4\uC218\uB85C
      \uAD6C\uB9E4\uD55C \uD56D\uBAA9\uC5D0 \uB300\uD574 \uD658\uBD88\uC744 \uBC1B\uC73C\uB824\uBA74
      \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD558\uB098\uC694?\r\n\uACB0\uC81C \uAD00\uB828
      \uC808\uCC28\uC5D0 \uB300\uD574 \uC800\uD76C\uB294 \uAD00\uC5EC\uD560 \uAD8C\uD55C\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4. \uC2A4\uD1A0\uC5B4 \uD658\uBD88 \uC815\uCC45\uC744
      \uCC38\uC870\uD558\uC2DC\uACE0, \uACB0\uC81C \uBB38\uC81C \uB610\uB294 \uD658\uBD88
      \uC694\uCCAD\uC5D0 \uB300\uD574\uC11C\uB294 App Store \uC9C0\uC6D0\uD300\uC5D0
      \uBB38\uC758\uD558\uC2ED\uC2DC\uC624.\r\n\uB0B4 \uAD6C\uB3C5\uC744 \uCDE8\uC18C\uD558\uB824\uBA74
      \uC5B4\uB5BB\uAC8C \uD558\uB098\uC694?\r\n\uC571\uC740 \uB2E8\uC77C \uACB0\uC81C\uB85C
      \uC774\uC6A9\uD560 \uC218 \uC788\uB098\uC694, \uC544\uB2C8\uBA74 \uAD6C\uB3C5
      \uAE30\uBC18\uC778\uAC00\uC694?\r\n\uB300\uBD80\uBD84\uC758 \uC571\uC740 \uC77C\uD68C\uC131
      \uC778\uC571 \uAD6C\uB9E4\uB97C \uC81C\uACF5\uD558\uC5EC \uCD94\uAC00 \uBE44\uC6A9
      \uC5C6\uC774 \uBB34\uC81C\uD55C \uC561\uC138\uC2A4\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4.
      \uC774 \uC560\uD50C\uB9AC\uCF00\uC774\uC158 - 'Lalafun Mini Games For Kids'\uB294
      \uC77C\uD68C\uC131 \uAD6C\uB9E4\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4. \uADF8\uB7EC\uB098
      \uC77C\uBD80 \uC571\uC740 (\uB610\uB294 \uC55E\uC73C\uB85C \uAD6C\uB3C5 \uBAA8\uB378\uC744
      \uC0AC\uC6A9\uD560 \uC608\uC815\uC785\uB2C8\uB2E4).\r\n\uC571\uC744 \uC0AC\uC6A9\uD558\uB824\uBA74
      \uC778\uD130\uB137 \uC5F0\uACB0\uC774 \uD544\uC694\uD569\uB2C8\uAE4C?\r\n\uC571
      \uC2A4\uD1A0\uC5B4\uC5D0\uC11C \uC571\uC744 \uB2E4\uC6B4\uB85C\uB4DC\uD558\uACE0
      \uC124\uCE58\uD558\uB824\uBA74 \uC778\uD130\uB137 \uC5F0\uACB0\uC774 \uD544\uC694\uD569\uB2C8\uB2E4\u3002\uADF8\uB7EC\uB098
      \uC571\uC774 \uAE30\uAE30\uC5D0 \uC124\uCE58\uB41C \uD6C4\uC5D0\uB294 \uC778\uD130\uB137
      \uC5F0\uACB0\uC744 \uB04A\uACE0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4\u3002\uC608\uC678:
      \uC77C\uBD80 \uC571\uC740 \uAC8C\uC784 \uC9C4\uD589\uC744 \uB3D9\uAE30\uD654\uD558\uAC70\uB098
      \uC5C5\uB370\uC774\uD2B8\uB97C \uBC1B\uAC70\uB098 \uC0C8\uB85C\uC6B4 \uCF58\uD150\uCE20\uB97C
      \uBC1B\uAE30 \uC704\uD574 \uC778\uD130\uB137 \uC5F0\uACB0\uC774 \uD544\uC694\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4\u3002\r\n\uC571\uC5D0 \uAD11\uACE0\uAC00 \uC788\uC2B5\uB2C8\uAE4C?\r\n\uC800\uD76C
      \uC571\uC740 \uC644\uC804\uD788 \uAD11\uACE0\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4\u3002\"\uCD94\uAC00
      \uC571\" \uC139\uC158\uB9CC \uC788\uC73C\uBA70, \uC774\uB294 \uBD80\uBAA8 \uAC8C\uC774\uD2B8\uC5D0
      \uC758\uD574 \uBCF4\uD638\uB418\uC5B4 \uC788\uC5B4 \uC544\uC774\uB4E4\uC774
      \uC811\uADFC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4\u3002\uC571\uC744 \uC2DC\uC791\uD558\uAE30
      \uC804\uC5D0 \uC778\uD130\uB137 \uC5F0\uACB0\uC744 \uB04A\uC73C\uBA74 \uC774
      \uC139\uC158\uC744 \uBE44\uD65C\uC131\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4\u3002\r\n\uBB38\uC758\uD558\uAE30\r\nGoogle
      Play \uD658\uBD88 \uC815\uCC45 \uBC0F \uC5F0\uB77D\uCC98 \uB9C1\uD06C.\r\niOS
      \uC571 \uC2A4\uD1A0\uC5B4\uC5D0\uC11C \uD658\uBD88\uC744 \uBC1B\uB294 \uBC29\uBC95\uC5D0
      \uB300\uD55C \uC9C0\uCE68\uC740 \uC5EC\uAE30\uC5D0\uC11C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC571\uC774 \uBB34\uB8CC\uC778\uAC00\uC694?\r\n\uC571\uC740
      \uBB34\uB8CC\uB85C \uB2E4\uC6B4\uB85C\uB4DC\uD560 \uC218 \uC788\uC73C\uBA70
      \uB2E4\uC591\uD55C \uAC8C\uC784, \uC0C9\uCE60 \uACF5\uBD80, \uC560\uB2C8\uBA54\uC774\uC158\uC774
      \uD3EC\uD568\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uCD94\uAC00 \uCF58\uD150\uCE20\uB294
      \uC571 \uB0B4 \uD329\uC73C\uB85C \uAD6C\uB9E4\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC571\uC774
      \uC5B4\uB9B0\uC774\uC5D0\uAC8C \uC548\uC804\uD55C\uAC00\uC694?\r\n\uB124, \uC774
      \uC571\uC740 \uC5C4\uACA9\uD55C \uC548\uC804 \uC870\uCE58\uB97C \uD1B5\uD574
      \uC5B4\uB9B0\uC774\uB97C \uC704\uD574 \uD2B9\uBCC4\uD788 \uC124\uACC4\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uAD11\uACE0\uB098 \uC678\uBD80 \uB9C1\uD06C\uAC00 \uC5C6\uC73C\uBA70 \uAC1C\uC778
      \uC815\uBCF4\uB97C \uC218\uC9D1\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC0C8\uB85C\uC6B4
      \uCF58\uD150\uCE20\uB294 \uC5BC\uB9C8\uB098 \uC790\uC8FC \uCD94\uAC00\uB418\uB098\uC694?\r\n\uC571\uC744
      \uC2E0\uC120\uD558\uACE0 \uB9E4\uB825\uC801\uC73C\uB85C \uC720\uC9C0\uD558\uAE30
      \uC704\uD574 \uC0C8\uB85C\uC6B4 \uC0C9\uCE60 \uD398\uC774\uC9C0\uC640 \uC560\uB2C8\uBA54\uC774\uC158\uC774
      \uC815\uAE30\uC801\uC73C\uB85C \uCD94\uAC00\uB429\uB2C8\uB2E4.\r\n\uC571\uC774
      \uCDA9\uB3CC\uD558\uAC70\uB098 \uBB38\uC81C\uAC00 \uBC1C\uC0DD\uD558\uBA74
      \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD558\uB098\uC694?\r\n\uBB38\uC81C\uAC00 \uBC1C\uC0DD\uD558\uBA74
      {supportLink}\uC73C\uB85C \uC9C0\uC6D0\uD300\uC5D0 \uBB38\uC758\uD558\uAC70\uB098
      {websiteLink}\uC758 \uB3C4\uC6C0\uB9D0 \uC13C\uD130\uB97C \uBC29\uBB38\uD558\uC138\uC694.
      \uC800\uD76C\uAC00 \uB3C4\uC640\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!\r\n\uC774
      \uC571\uC744 \uC5B4\uB5BB\uAC8C \uAD6C\uB9E4\uD560 \uC218 \uC788\uB098\uC694?\r\n\uC571\uC744
      \uC2DC\uC791\uD558\uAE30 \uC804\uC5D0 \uC720\uD6A8\uD55C \uACB0\uC81C \uBC29\uBC95\uACFC
      \uD65C\uC131 \uC778\uD130\uB137 \uC5F0\uACB0\uC774 \uC788\uB294\uC9C0 \uD655\uC778\uD558\uC138\uC694.
      \uADF8\uB7F0 \uB2E4\uC74C \uC7A0\uAE34 \uCF58\uD150\uCE20\uB97C \uB204\uB974\uACE0
      \uBD80\uBAA8 \uAC8C\uC774\uD2B8\uB97C \uD1B5\uACFC\uD55C \uD6C4 \uC77C\uBC18
      \uAD6C\uB9E4 \uC808\uCC28\uB97C \uB530\uB974\uC138\uC694.\r\n\uAD6C\uB9E4\uB97C
      \uBCF5\uAD6C/\uC774\uC804\uD558\uB824\uBA74 \uC5B4\uB5BB\uAC8C \uD574\uC57C
      \uD558\uB098\uC694?\r\n\"\uB2E4\uC74C \uB2E8\uACC4\uB97C \uB530\uB974\uC138\uC694:\r\n1.
      \uC6D0\uB798 \uAD6C\uB9E4\uAC00 \uC774\uB8E8\uC5B4\uC9C4 \uACC4\uC815\uC744
      \uC124\uC815\uD558\uC138\uC694.\r\n2. \uD574\uB2F9 \uACC4\uC815\uC744 \uC0AC\uC6A9\uD558\uC5EC
      \uC571\uC744 \uB2E4\uC6B4\uB85C\uB4DC\uD558\uC138\uC694.\r\n3. \uC778\uD130\uB137
      \uC5F0\uACB0\uC774 \uD65C\uC131\uD654\uB418\uC5B4 \uC788\uB294\uC9C0 \uD655\uC778\uD558\uC138\uC694.\r\n4.
      \uC571\uC744 \uC2E4\uD589\uD558\uC138\uC694.\r\n\uCC38\uACE0: \uC778\uC571
      \uAD6C\uB9E4 \uBCF5\uAD6C\uB294 \uC6D0\uB798\uC758 \uC2A4\uD1A0\uC5B4 \uB0B4\uC5D0\uC11C\uB9CC
      \uAC00\uB2A5\uD569\uB2C8\uB2E4.\"\r\nGoogle Play \uD328\uBC00\uB9AC \uB77C\uC774\uBE0C\uB7EC\uB9AC\uB97C
      \uC0AC\uC6A9\uD558\uC5EC \uC778\uC571 \uAD6C\uB9E4\uB97C \uACF5\uC720\uD560
      \uC218 \uC788\uC2B5\uB2C8\uAE4C?\r\n\uBD88\uD589\uD788\uB3C4 Google Play \uD328\uBC00\uB9AC
      \uB77C\uC774\uBE0C\uB7EC\uB9AC\uC5D0\uC11C \uC778\uC571 \uAD6C\uB9E4\uB97C
      \uACF5\uC720\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uAC01 \uC571 \uC2A4\uD1A0\uC5B4\uB294
      \uC790\uCCB4\uC801\uC778 \uACF5\uC720 \uAE30\uB2A5\uC744 \uAC00\uC9C0\uACE0
      \uC788\uC73C\uBA70, \uC774\uB294 \uC800\uD76C \uD1B5\uC81C \uBC94\uC704\uB97C
      \uBC97\uC5B4\uB0A9\uB2C8\uB2E4.\r\n\uC2E4\uC218\uB85C \uAD6C\uB9E4\uD55C \uD56D\uBAA9\uC5D0
      \uB300\uD574 \uD658\uBD88\uC744 \uBC1B\uC73C\uB824\uBA74 \uC5B4\uB5BB\uAC8C
      \uD574\uC57C \uD558\uB098\uC694?\r\n\uACB0\uC81C \uAD00\uB828 \uC808\uCC28\uC5D0
      \uB300\uD574\uC11C\uB294 \uC800\uD76C\uC5D0\uAC8C \uAD8C\uD55C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.
      Android\uB97C \uC0AC\uC6A9\uD558\uB294 \uACBD\uC6B0 \uC2A4\uD1A0\uC5B4\uC758
      \uD658\uBD88 \uC815\uCC45\uC744 \uB530\uB974\uACE0, \uACB0\uC81C \uBB38\uC81C\uB098
      \uD658\uBD88 \uBB38\uC758\uC5D0 \uB300\uD574\uC11C\uB294 Google Play \uC9C0\uC6D0\uD300\uC5D0
      \uC9C1\uC811 \uBB38\uC758\uD558\uC2ED\uC2DC\uC624.\r\n\uB0B4 \uAD6C\uB3C5\uC744
      \uCDE8\uC18C\uD558\uB824\uBA74 \uC5B4\uB5BB\uAC8C \uD558\uB098\uC694?\r\n\"\uC774
      \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC5D0\uB294 \uAD6C\uB3C5 \uC635\uC158\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4. 'Lalafun Coloring For Kids' \uC571\uC740 \uBAA8\uB4E0
      \uCF58\uD150\uCE20\uC640 \uB3C4\uAD6C\uB97C \uD3C9\uC0DD \uC0AC\uC6A9\uD560
      \uC218 \uC788\uB3C4\uB85D \uB2E8\uC77C \uAD6C\uB9E4 \uC635\uC158\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4.
      \uAD6C\uB3C5 \uACC4\uD68D\uC774 \uD3EC\uD568\uB41C \uB2E4\uB978 \uC571\uC758
      \uACBD\uC6B0 \uAD6C\uB3C5 \uCDE8\uC18C \uBC29\uBC95\uC5D0 \uB300\uD55C \uC9C0\uCE68\uC744
      \uB530\uB974\uC2ED\uC2DC\uC624:\r\n 1. Google Play \uC571\uC744 \uC5FD\uB2C8\uB2E4.\r\n
      2. \uC624\uB978\uCABD \uC0C1\uB2E8\uC758 \uD504\uB85C\uD544 \uC544\uC774\uCF58\uC744
      \uD0ED\uD569\uB2C8\uB2E4.\r\n 3. \"\"\uACB0\uC81C \uBC0F \uAD6C\uB3C5\"\",
      \uADF8 \uB2E4\uC74C \"\"\uAD6C\uB3C5\"\"\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.\r\n
      4. \uCDE8\uC18C\uD560 \uAD6C\uB3C5\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4.\r\n
      5. \"\"\uAD6C\uB3C5 \uCDE8\uC18C\"\"\uB97C \uD0ED\uD569\uB2C8\uB2E4.\r\n 6.
      \uC9C0\uC2DC\uC5D0 \uB530\uB77C \uC9C4\uD589\uD558\uC2ED\uC2DC\uC624\u3002\"\r\n\uC571\uC740
      \uB2E8\uC77C \uACB0\uC81C\uB85C \uC774\uC6A9\uD560 \uC218 \uC788\uB098\uC694,
      \uC544\uB2C8\uBA74 \uAD6C\uB3C5 \uAE30\uBC18\uC778\uAC00\uC694?\r\n\uB300\uBD80\uBD84\uC758
      \uC571\uC740 \uC77C\uD68C\uC131 \uC778\uC571 \uAD6C\uB9E4\uB97C \uD1B5\uD574
      \uCD94\uAC00 \uBE44\uC6A9 \uC5C6\uC774 \uBB34\uC81C\uD55C\uC73C\uB85C \uC774\uC6A9\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. '\uB77C\uB77C\uD380 \uD0A4\uC988 \uBBF8\uB2C8
      \uAC8C\uC784\uC988' \uC571\uC740 \uC6D4\uAC04 \uB610\uB294 \uC5F0\uAC04 \uAD6C\uB3C5\uC744
      \uC81C\uACF5\uD569\uB2C8\uB2E4.\r\n\uC571\uC744 \uC0AC\uC6A9\uD558\uB824\uBA74
      \uC778\uD130\uB137 \uC5F0\uACB0\uC774 \uD544\uC694\uD569\uB2C8\uAE4C?\r\n\uC571
      \uC2A4\uD1A0\uC5B4\uC5D0\uC11C \uC571\uC744 \uB2E4\uC6B4\uB85C\uB4DC\uD558\uACE0
      \uC124\uCE58\uD558\uB824\uBA74 \uC778\uD130\uB137 \uC5F0\uACB0\uC774 \uD544\uC694\uD569\uB2C8\uB2E4\u3002\uADF8\uB7EC\uB098
      \uC571\uC774 \uAE30\uAE30\uC5D0 \uC124\uCE58\uB41C \uD6C4\uC5D0\uB294 \uC778\uD130\uB137
      \uC5F0\uACB0\uC744 \uB04A\uACE0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4\u3002\uC608\uC678:
      \uC77C\uBD80 \uC571\uC740 \uAC8C\uC784 \uC9C4\uD589\uC744 \uB3D9\uAE30\uD654\uD558\uAC70\uB098
      \uC5C5\uB370\uC774\uD2B8\uB97C \uBC1B\uAC70\uB098 \uC0C8\uB85C\uC6B4 \uCF58\uD150\uCE20\uB97C
      \uBC1B\uAE30 \uC704\uD574 \uC778\uD130\uB137 \uC5F0\uACB0\uC774 \uD544\uC694\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4\u3002\r\n\uC571\uC5D0 \uAD11\uACE0\uAC00 \uC788\uC2B5\uB2C8\uAE4C?\r\n\uC800\uD76C
      \uC571\uC740 \uC644\uC804\uD788 \uAD11\uACE0\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4\u3002\"\uCD94\uAC00
      \uC571\" \uC139\uC158\uB9CC \uC788\uC73C\uBA70, \uC774\uB294 \uBD80\uBAA8 \uAC8C\uC774\uD2B8\uC5D0
      \uC758\uD574 \uBCF4\uD638\uB418\uC5B4 \uC788\uC5B4 \uC544\uC774\uB4E4\uC774
      \uC811\uADFC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4\u3002\uC571\uC744 \uC2DC\uC791\uD558\uAE30
      \uC804\uC5D0 \uC778\uD130\uB137 \uC5F0\uACB0\uC744 \uB04A\uC73C\uBA74 \uC774
      \uC139\uC158\uC744 \uBE44\uD65C\uC131\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4\u3002\r\n\uC571\uC774
      \uBB34\uB8CC\uC778\uAC00\uC694?\r\n\uC571\uC740 \uBB34\uB8CC\uB85C \uB2E4\uC6B4\uB85C\uB4DC\uD560
      \uC218 \uC788\uC73C\uBA70 \uB2E4\uC591\uD55C \uC0C9\uCE60\uD558\uAE30 \uD398\uC774\uC9C0\uC640
      \uC560\uB2C8\uBA54\uC774\uC158\uC774 \uD3EC\uD568\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.
      \uCD94\uAC00 \uCF58\uD150\uCE20\uB294 \uC120\uD0DD\uD615 \uC778\uC571 \uD328\uD0A4\uC9C0\uB85C
      \uAD6C\uB9E4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC571\uC774 \uC5B4\uB9B0\uC774\uC5D0\uAC8C
      \uC548\uC804\uD55C\uAC00\uC694?\r\n\uB124, \uC774 \uC571\uC740 \uC5C4\uACA9\uD55C
      \uC548\uC804 \uC870\uCE58\uB97C \uD1B5\uD574 \uC5B4\uB9B0\uC774\uB97C \uC704\uD574
      \uD2B9\uBCC4\uD788 \uC124\uACC4\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uAD11\uACE0\uB098
      \uC678\uBD80 \uB9C1\uD06C\uAC00 \uC5C6\uC73C\uBA70 \uAC1C\uC778 \uC815\uBCF4\uB97C
      \uC218\uC9D1\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC0C8\uB85C\uC6B4 \uCF58\uD150\uCE20\uB294
      \uC5BC\uB9C8\uB098 \uC790\uC8FC \uCD94\uAC00\uB418\uB098\uC694?\r\n\uC571\uC744
      \uC2E0\uC120\uD558\uACE0 \uB9E4\uB825\uC801\uC73C\uB85C \uC720\uC9C0\uD558\uAE30
      \uC704\uD574 \uC0C8\uB85C\uC6B4 \uC0C9\uCE60 \uD398\uC774\uC9C0\uC640 \uC560\uB2C8\uBA54\uC774\uC158\uC774
      \uC815\uAE30\uC801\uC73C\uB85C \uCD94\uAC00\uB429\uB2C8\uB2E4.\r\n\uC571\uC774
      \uCDA9\uB3CC\uD558\uAC70\uB098 \uBB38\uC81C\uAC00 \uBC1C\uC0DD\uD558\uBA74
      \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD558\uB098\uC694?\r\n\uBB38\uC81C\uAC00 \uBC1C\uC0DD\uD558\uBA74
      {supportLink}\uC73C\uB85C \uC9C0\uC6D0\uD300\uC5D0 \uBB38\uC758\uD558\uAC70\uB098
      {websiteLink}\uC758 \uB3C4\uC6C0\uB9D0 \uC13C\uD130\uB97C \uBC29\uBB38\uD558\uC138\uC694.
      \uC800\uD76C\uAC00 \uB3C4\uC640\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!\r\n\uC804\uCCB4
      \uC561\uC138\uC2A4\r\n\uC804\uCCB4 \uBC84\uC804 \uC7A0\uAE08 \uD574\uC81C\r\n\uD3C9\uC0DD
      \uC561\uC138\uC2A4\r\n\uC7A0\uAE08 \uD574\uC81C\r\n\uAD6C\uB3C5 \uBCF5\uC6D0\r\n\uAC1C\uC778\uC815\uBCF4
      \uCC98\uB9AC\uBC29\uCE68\r\n\uC774\uC6A9 \uC57D\uAD00\r\n\uC815\uAE30 \uC5C5\uB370\uC774\uD2B8\r\n\uAD11\uACE0
      \uC5C6\uB294 \uC5B4\uB9B0\uC774 \uC548\uC804 \uCF58\uD150\uCE20\r\n\uC548\uC804\uD558\uACE0
      \uB2E4\uC591\uD55C \uCF58\uD150\uCE20\r\n39\uAC1C \uC5B8\uC5B4\uB85C \uC81C\uACF5\r\n50\uAC1C
      \uC774\uC0C1\uC758 \uAD50\uC721\uC6A9 \uAC8C\uC784\uACFC \uBE44\uB514\uC624\r\n\uB180\uC774\uB97C
      \uD1B5\uD55C \uD559\uC2B5\r\n\uC778\uD130\uB137 \uC5C6\uC774 \uC791\uB3D9\r\n\uBBF8\uC138
      \uC6B4\uB3D9 \uB2A5\uB825 \uAC1C\uBC1C\r\n\uC544\uB3D9 \uB17C\uB9AC\uC758 \uBC1C\uB2EC\r\n\uAD6C\uB3C5\uC744
      \uD1B5\uD55C \uC804\uCCB4 \uC561\uC138\uC2A4\r\n\uBC1D\uC740 \uC560\uB2C8\uBA54\uC774\uC158\r\n\uC815\uAE30
      \uC5C5\uB370\uC774\uD2B8\r\n1.5~4\uC138 \uC5B4\uB9B0\uC774\uB97C \uC704\uD574
      \uC81C\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uC804\uBB38\uC801\uC778 \uC5B4\uB9B0\uC774
      \uCF58\uD150\uCE20\r\n\uAD6C\uB3C5\uC774 \uACE7 \uC885\uB8CC\uB429\uB2C8\uB2E4.\r\n\uAD6C\uB3C5\uC774
      \uACE7 \uC885\uB8CC\uB429\uB2C8\uB2E4. \uC790\uB140\uAC00 \uACC4\uC18D\uD574\uC11C
      \uB180\uACE0 \uD559\uC2B5\uD560 \uC218 \uC788\uB3C4\uB85D \uC5D0\uC11C \uAD6C\uB3C5\uC744
      \uAC31\uC2E0\uD574 \uC8FC\uC138\uC694.\r\n\uAD6C\uB3C5\uC774 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4\r\n\uC885\uB8CC\uC77C:\r\n\uAD6C\uB3C5\uC744
      \uAC31\uC2E0\uD558\uC2DC\uBA74 \uC790\uB140\uAC00 \uACC4\uC18D\uD574\uC11C
      \uB180\uACE0 \uC131\uC7A5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC31\uC2E0\uD558\uB824\uBA74
      \uAC1C\uC778 \uACC4\uC815\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694.\r\n\uAE38\uAC8C
      \uD558\uB2E4\r\n\uB9E4\uB144\r\n\uC6D4\uAC04 \uAC04\uD589\uBB3C\r\n\uBBF8\uB2C8
      \uAC8C\uC784\r\n\uBD80\uBAA8\uB2D8\uC744 \uC704\uD55C\r\n\uB3D9\uBB3C\uB4E4\r\n\uC694\uB9AC\r\n\uB3D9\uC601\uC0C1\r\n\uCC29\uC0C9\r\n\uACC4\uB7B5\r\n\uACC4\uC0B0\uD574
      \uC8FC\uC138\uC694\r\n\uBB34\uB8CC\r\n\uC790\uB3D9\uCC28 \uC870\uB9BD\r\n\uCEEC\uB7EC\uD2B8\uB808\uC778\r\n\uACF5\uC8FC
      \uB4DC\uB808\uC2F1\r\n\uBC29 \uCCAD\uC18C\r\n\uBBF8\uC6A9\uC2E4\r\n\uCF00\uC774\uD06C\r\n\uC544\uC774\uC2A4\uD06C\uB9BC\r\n\uC0D0\uB7EC\uB4DC\r\n\uBC84\uAC70\r\n\uAC15\uC544\uC9C0\uC758
      \uC74C\uC2DD\r\n\uD53C\uC790\r\n\uB18D\uC7A5 \uC624\uCF00\uC2A4\uD2B8\uB77C\r\n\uC218\uC911
      \uC624\uCF00\uC2A4\uD2B8\uB77C\r\n\uB18D\uBD80\uC758 \uD37C\uC990\r\n\uC228\uBC14\uAF2D\uC9C8\r\n\uAC70\uD488\r\n\uC138\uCC28\uC7A5\r\n\uB204\uAD6C\uC758
