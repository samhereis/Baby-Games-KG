    characterSetSelectionMode: 8
    characterSequence: "\u5B8C\u6574\u8BBF\u95EE\n\u6700\u559C\u6B22\u7684\n\u5173\u4E8E\u6211\u4EEC\n\u8BA4\u8BC6
      Saratan Animations Studio \u80CC\u540E\u7684\u70ED\u60C5\u56E2\u961F\u3002\u6211\u4EEC\u7684\u56E2\u961F\u662F\u7531\u4E00\u7FA4\u81F4\u529B\u4E8E\u4E3A\u513F\u7AE5\u5F00\u53D1\u6559\u80B2\u548C\u5A31\u4E50\u5E94\u7528\u7684\u521B\u610F\u4EBA\u58EB\u7EC4\u6210\u7684\u591A\u5143\u5316\u56E2\u961F\u3002\u6211\u4EEC\u76EE\u524D\u7684\u5E94\u7528\u7A0B\u5E8F
      Lalafun - Mini Games for Kids\uFF0C\u901A\u8FC7\u6709\u8DA3\u548C\u4E92\u52A8\u7684\u6D3B\u52A8\u6FC0\u53D1\u5E74\u8F7B\u4EBA\u7684\u60F3\u8C61\u529B\u3002\u52A0\u5165\u6211\u4EEC\u7684\u65C5\u7A0B\uFF0C\u521B\u9020\u5168\u7403\u513F\u7AE5\u7684\u5FEB\u4E50\u5B66\u4E60\u4F53\u9A8C\u3002\n\u4E3A\u4EC0\u4E48\u7236\u6BCD\u4FE1\u4EFB\u6211\u4EEC\n\u65E0\u5E7F\u544A\n\u6211\u4EEC\u7684\u5E94\u7528\u7A0B\u5E8F\u6CA1\u6709\u5E7F\u544A\uFF0C\u786E\u4FDD\u60A8\u7684\u5B69\u5B50\u4EAB\u6709\u5B89\u5168\u3001\u65E0\u5E72\u6270\u7684\u5B66\u4E60\u4F53\u9A8C\u3002\n\u5B89\u5168\u5185\u5BB9\n\u6211\u4EEC\u7684\u5185\u5BB9\u7ECF\u8FC7\u7CBE\u5FC3\u8BBE\u8BA1\uFF0C\u786E\u4FDD\u5B83\u65E2\u5B89\u5168\u53C8\u9002\u5408\u513F\u7AE5\u3002\n\u5B66\u9F84\u524D\u513F\u7AE5\n\u6211\u4EEC\u7684\u5E94\u7528\u4E13\u4E3A2\u81F35\u5C81\u7684\u513F\u7AE5\u8BBE\u8BA1\uFF0C\u975E\u5E38\u9002\u5408\u5B66\u9F84\u524D\u513F\u7AE5\u3002\n\u5E94\u7528\u4E2D\u7684\u672C\u5730\u5316\n\u6211\u4EEC\u7684\u5E94\u7528\u652F\u6301\u591A\u79CD\u8BED\u8A00\uFF0C\u4F7F\u5176\u80FD\u591F\u4E3A\u5168\u7403\u7684\u513F\u7AE5\u4F7F\u7528\u3002\n\u4E92\u52A8\u5B66\u4E60\n\u6211\u4EEC\u7684\u5E94\u7528\u662F\u4E92\u52A8\u7684\u548C\u6559\u80B2\u6027\u7684\uFF0C\u4FC3\u8FDB\u53D1\u5C55\u5E76\u6559\u6388\u57FA\u672C\u6280\u80FD\u3002\n\u514D\u8D39\u6E38\u620F\n\u514D\u8D39\u8BD5\u7528\u6211\u4EEC\u7684\u6E38\u620F\uFF0C\u652F\u6301\u5B69\u5B50\u7684\u6210\u957F\u3002\u53D1\u73B0\u4E00\u4E2A\u5145\u6EE1\u4E50\u8DA3\u548C\u6559\u80B2\u6D3B\u52A8\u7684\u4E16\u754C\uFF01\n\u4EAB\u53D7\u6211\u4EEC\u7684\u5E94\u7528\u5417\uFF1F\n\u8BF7\u5E2E\u52A9\u6211\u4EEC\u53D8\u5F97\u66F4\u597D\uFF01\n\u7ED9\u6211\u4EEC\u8BC4\u5206\n\u5E38\u89C1\u95EE\u9898
      (FAQ)\n\u5982\u679C\u4F60\u6709\u4EFB\u4F55\u95EE\u9898\uFF0C\u8BF7\u5199\u4FE1\u7ED9\u6211\u4EEC:
      {emailName}\n\u5982\u4F55\u8D2D\u4E70\u8FD9\u4E2A\u5E94\u7528\u7A0B\u5E8F\uFF1F\n\u8BF7\u786E\u4FDD\u5728\u542F\u52A8\u5E94\u7528\u7A0B\u5E8F\u4E4B\u524D\uFF0C\u4F60\u6709\u4E00\u4E2A\u6709\u6548\u7684\u652F\u4ED8\u65B9\u5F0F\u548C\u6D3B\u8DC3\u7684\u4E92\u8054\u7F51\u8FDE\u63A5\u3002\u7136\u540E\uFF0C\u70B9\u51FB\u88AB\u9501\u5B9A\u7684\u5185\u5BB9\uFF0C\u8FDB\u5165\u5BB6\u957F\u95E8\u5E76\u6309\u7167\u6807\u51C6\u8D2D\u4E70\u6D41\u7A0B\u8FDB\u884C\u64CD\u4F5C\u3002\n\u5982\u4F55\u6062\u590D/\u8F6C\u79FB\u6211\u7684\u8D2D\u4E70\uFF1F\n\"\u8BF7\u6309\u4EE5\u4E0B\u6B65\u9AA4\u64CD\u4F5C:\n1.
      \u8BBE\u7F6E\u6700\u521D\u8D2D\u4E70\u65F6\u4F7F\u7528\u7684\u8D26\u6237\u3002\n2.
      \u4F7F\u7528\u8BE5\u8D26\u6237\u4E0B\u8F7D\u5E94\u7528\u7A0B\u5E8F\u3002\n3.
      \u786E\u4FDD\u4E92\u8054\u7F51\u8FDE\u63A5\u5DF2\u5F00\u542F\u3002\n4. \u542F\u52A8\u5E94\u7528\u7A0B\u5E8F\u3002\n\u6CE8\u610F:
      \u5E94\u7528\u5185\u8D2D\u4E70\u7684\u6062\u590D\u53EA\u80FD\u5728\u539F\u59CB\u5546\u5E97\u4E2D\u5B8C\u6210\u3002\"\n\u6211\u5982\u4F55\u901A\u8FC7
      Apple Family Sharing \u8BA1\u5212\u5171\u4EAB\u6211\u7684\u5E94\u7528\u5185\u8D2D\u4E70\uFF1F\n\"\u8981\u8BBE\u7F6E
      Family Sharing\uFF1A\n1 - \u6253\u5F00\u201C\u8BBE\u7F6E\u201D\u3002\n2 - \u70B9\u51FB\u60A8\u7684\u540D\u5B57\u3002\n3
      - \u9009\u62E9\u201C\u5BB6\u4EBA\u5171\u4EAB\u201D\u3002\n4 - \u9009\u62E9\u201C\u8BBE\u7F6E\u60A8\u7684\u5BB6\u5EAD\u201D\u3002\n\u6309\u7167\u5C4F\u5E55\u4E0A\u7684\u8BF4\u660E\u8BBE\u7F6E\u5BB6\u5EAD\u5E76\u9080\u8BF7\u6210\u5458\u3002\"\n\u6211\u5982\u4F55\u83B7\u5F97\u610F\u5916\u8D2D\u4E70\u7684\u9000\u6B3E?\n\u6211\u4EEC\u65E0\u6743\u5904\u7406\u4E0E\u4ED8\u6B3E\u76F8\u5173\u7684\u7A0B\u5E8F\u3002\u8BF7\u53C2\u9605\u5546\u5E97\u7684\u9000\u6B3E\u653F\u7B56\uFF0C\u5E76\u8054\u7CFB
      App Store \u652F\u6301\u56E2\u961F\u4EE5\u89E3\u51B3\u4ED8\u6B3E\u76F8\u5173\u95EE\u9898\u6216\u9000\u6B3E\u8BF7\u6C42\u3002\n\u6211\u5982\u4F55\u53D6\u6D88\u6211\u7684\u8BA2\u9605?\n\u60A8\u7684\u5E94\u7528\u662F\u5355\u6B21\u4ED8\u8D39\u7684\u8FD8\u662F\u57FA\u4E8E\u8BA2\u9605\u7684?\n\u6211\u4EEC\u7684\u5927\u591A\u6570\u5E94\u7528\u90FD\u63D0\u4F9B\u4E00\u6B21\u6027\u5E94\u7528\u5185\u8D2D\u4E70\uFF0C\u4F7F\u60A8\u65E0\u9700\u989D\u5916\u8D39\u7528\u5373\u53EF\u83B7\u5F97\u65E0\u9650\u8BBF\u95EE\u6743\u9650\u3002\u8BE5\u5E94\u7528\u7A0B\u5E8F
      - 'Lalafun Mini Games For Kids' \u63D0\u4F9B\u4E00\u6B21\u6027\u8D2D\u4E70\u3002\u7136\u800C\uFF0C\u6211\u4EEC\u6709\uFF08\u6216\u5C06\u6765\u4F1A\u6709\uFF09\u4E00\u4E9B\u4F7F\u7528\u8BA2\u9605\u6A21\u5F0F\u7684\u5E94\u7528\u3002\n\u4F7F\u7528\u60A8\u7684\u5E94\u7528\u662F\u5426\u9700\u8981\u59CB\u7EC8\u8FDE\u63A5\u7F51\u7EDC?\n\u9700\u8981\u7F51\u7EDC\u8FDE\u63A5\u6765\u4ECE\u5E94\u7528\u5546\u5E97\u4E0B\u8F7D\u548C\u5B89\u88C5\u6211\u4EEC\u7684\u5E94\u7528\u7A0B\u5E8F\u3002\u7136\u800C\uFF0C\u4E00\u65E6\u5E94\u7528\u5B89\u88C5\u5230\u60A8\u7684\u8BBE\u5907\u4E0A\uFF0C\u60A8\u53EF\u4EE5\u5173\u95ED\u7F51\u7EDC\u8FDE\u63A5\u5E76\u4F7F\u7528\u5B83\u3002\u4F8B\u5916\uFF1A\u6211\u4EEC\u7684\u4E00\u4E9B\u5E94\u7528\u53EF\u80FD\u9700\u8981\u7F51\u7EDC\u8FDE\u63A5\u6765\u540C\u6B65\u6E38\u620F\u8FDB\u5EA6\u3001\u83B7\u53D6\u66F4\u65B0\u6216\u65B0\u5185\u5BB9\u3002\n\u60A8\u7684\u5E94\u7528\u6709\u5E7F\u544A\u5417?\n\u6211\u4EEC\u7684\u5E94\u7528\u5B8C\u5168\u6CA1\u6709\u5E7F\u544A\u3002\u53EA\u6709\u201C\u66F4\u591A\u5E94\u7528\u201D\u90E8\u5206\uFF0C\u53D7\u5230\u5BB6\u957F\u63A7\u5236\u4FDD\u62A4\uFF0C\u4E0D\u5141\u8BB8\u513F\u7AE5\u8BBF\u95EE\u3002\u60A8\u53EF\u4EE5\u5728\u542F\u52A8\u5E94\u7528\u4E4B\u524D\u5173\u95ED\u7F51\u7EDC\u8FDE\u63A5\u4EE5\u7981\u7528\u6B64\u90E8\u5206\u3002\n\u8054\u7CFB\u6211\u4EEC\nGoogle
      Play \u9000\u6B3E\u653F\u7B56\u548C\u8054\u7CFB\u94FE\u63A5\u3002\n\u60A8\u53EF\u4EE5\u5728\u6B64\u5904\u627E\u5230\u4ECE
      iOS App Store \u83B7\u5F97\u9000\u6B3E\u7684\u8BF4\u660E.\n\u8FD9\u6B3E\u5E94\u7528\u662F\u514D\u8D39\u7684\u5417\uFF1F\n\u8BE5\u5E94\u7528\u7A0B\u5E8F\u53EF\u514D\u8D39\u4E0B\u8F7D\uFF0C\u5305\u542B\u5404\u79CD\u6E38\u620F\u3001\u6D82\u8272\u9875\u548C\u52A8\u753B\u3002\u5176\u4ED6\u5185\u5BB9\u53EF\u4F5C\u4E3A\u53EF\u9009\u7684\u5E94\u7528\u5185\u5305\u8D2D\u4E70\u3002\n\u8FD9\u6B3E\u5E94\u7528\u5BF9\u5B69\u5B50\u5B89\u5168\u5417\uFF1F\n\u662F\u7684\uFF0C\u8FD9\u6B3E\u5E94\u7528\u662F\u4E13\u4E3A\u513F\u7AE5\u8BBE\u8BA1\u7684\uFF0C\u91C7\u7528\u4E86\u4E25\u683C\u7684\u5B89\u5168\u63AA\u65BD\u3002\u6CA1\u6709\u5E7F\u544A\u3001\u5916\u90E8\u94FE\u63A5\uFF0C\u4E5F\u4E0D\u6536\u96C6\u4E2A\u4EBA\u6570\u636E\u3002\n\u65B0\u5185\u5BB9\u591A\u4E45\u66F4\u65B0\u4E00\u6B21\uFF1F\n\u4E3A\u4E86\u4FDD\u6301\u5E94\u7528\u7684\u65B0\u9C9C\u611F\u548C\u5438\u5F15\u529B\uFF0C\u6211\u4EEC\u4F1A\u5B9A\u671F\u6DFB\u52A0\u65B0\u7684\u6D82\u8272\u9875\u548C\u52A8\u753B\u3002\n\u5982\u679C\u5E94\u7528\u5D29\u6E83\u6216\u51FA\u73B0\u95EE\u9898\uFF0C\u6211\u8BE5\u600E\u4E48\u529E\uFF1F\n\u5982\u679C\u60A8\u9047\u5230\u95EE\u9898\uFF0C\u53EF\u4EE5\u901A\u8FC7
      {supportLink} \u8054\u7CFB\u6211\u4EEC\u7684\u652F\u6301\u56E2\u961F\uFF0C\u6216\u8005\u8BBF\u95EE\u6211\u4EEC\u7684\u7F51\u7AD9
      {websiteLink} \u83B7\u53D6\u5E2E\u52A9\u3002\u6211\u4EEC\u4F1A\u5C3D\u529B\u534F\u52A9\u60A8\uFF01\n\u5982\u4F55\u8D2D\u4E70\u8FD9\u4E2A\u5E94\u7528\u7A0B\u5E8F\uFF1F\n\u8BF7\u786E\u4FDD\u5728\u542F\u52A8\u5E94\u7528\u7A0B\u5E8F\u4E4B\u524D\uFF0C\u4F60\u6709\u4E00\u4E2A\u6709\u6548\u7684\u652F\u4ED8\u65B9\u5F0F\u548C\u6D3B\u8DC3\u7684\u4E92\u8054\u7F51\u8FDE\u63A5\u3002\u7136\u540E\uFF0C\u70B9\u51FB\u88AB\u9501\u5B9A\u7684\u5185\u5BB9\uFF0C\u8FDB\u5165\u5BB6\u957F\u95E8\u5E76\u6309\u7167\u6807\u51C6\u8D2D\u4E70\u6D41\u7A0B\u8FDB\u884C\u64CD\u4F5C\u3002\n\u5982\u4F55\u6062\u590D/\u8F6C\u79FB\u6211\u7684\u8D2D\u4E70\uFF1F\n\"\u8BF7\u6309\u4EE5\u4E0B\u6B65\u9AA4\u64CD\u4F5C:\n1.
      \u8BBE\u7F6E\u6700\u521D\u8D2D\u4E70\u65F6\u4F7F\u7528\u7684\u8D26\u6237\u3002\n2.
      \u4F7F\u7528\u8BE5\u8D26\u6237\u4E0B\u8F7D\u5E94\u7528\u7A0B\u5E8F\u3002\n3.
      \u786E\u4FDD\u4E92\u8054\u7F51\u8FDE\u63A5\u5DF2\u5F00\u542F\u3002\n4. \u542F\u52A8\u5E94\u7528\u7A0B\u5E8F\u3002\n\u6CE8\u610F:
      \u5E94\u7528\u5185\u8D2D\u4E70\u7684\u6062\u590D\u53EA\u80FD\u5728\u539F\u59CB\u5546\u5E97\u4E2D\u5B8C\u6210\u3002\"\n\u6211\u53EF\u4EE5\u4F7F\u7528
      Google Play \u5BB6\u5EAD\u5171\u4EAB\u5E93\u5206\u4EAB\u6211\u7684\u5E94\u7528\u5185\u8D2D\u4E70\u5417?\n\u5F88\u9057\u61BE\uFF0C\u65E0\u6CD5\u901A\u8FC7
      Google Play \u5BB6\u5EAD\u5171\u4EAB\u5E93\u5206\u4EAB\u5E94\u7528\u5185\u8D2D\u4E70\u3002\u6BCF\u4E2A\u5E94\u7528\u5546\u5E97\u90FD\u6709\u81EA\u5DF1\u7684\u5171\u4EAB\u529F\u80FD\uFF0C\u8FD9\u8D85\u51FA\u4E86\u6211\u4EEC\u7684\u63A7\u5236\u8303\u56F4\u3002\n\u6211\u5982\u4F55\u83B7\u5F97\u610F\u5916\u8D2D\u4E70\u7684\u9000\u6B3E?\n\u6211\u4EEC\u65E0\u6743\u5904\u7406\u4E0E\u652F\u4ED8\u76F8\u5173\u7684\u6D41\u7A0B\u3002\u5982\u679C\u60A8\u4F7F\u7528\u7684\u662F
      Android\uFF0C\u8BF7\u9075\u5FAA\u5546\u5E97\u7684\u9000\u6B3E\u653F\u7B56\uFF0C\u5E76\u76F4\u63A5\u8054\u7CFB
      Google Play \u652F\u6301\u56E2\u961F\u4EE5\u83B7\u53D6\u652F\u4ED8\u95EE\u9898\u6216\u9000\u6B3E\u76F8\u5173\u7684\u5E2E\u52A9\u3002\n\u6211\u5982\u4F55\u53D6\u6D88\u6211\u7684\u8BA2\u9605?\n\"\u5728\u6B64\u5E94\u7528\u7A0B\u5E8F\u4E2D\u6CA1\u6709\u8BA2\u9605\u9009\u9879\u3002
      'Lalafun Coloring For Kids' \u5E94\u7528\u63D0\u4F9B\u4E00\u6B21\u6027\u8D2D\u4E70\uFF0C\u89E3\u9501\u6240\u6709\u5185\u5BB9\u548C\u5DE5\u5177\u4EE5\u7EC8\u8EAB\u4F7F\u7528\u3002\u5BF9\u4E8E\u5176\u4ED6\u5305\u542B\u8BA2\u9605\u8BA1\u5212\u7684\u5E94\u7528\uFF0C\u8BF7\u6309\u7167\u4EE5\u4E0B\u8BF4\u660E\u53D6\u6D88\u8BA2\u9605\uFF1A\n
      1. \u6253\u5F00 Google Play \u5E94\u7528\u3002\n 2. \u70B9\u51FB\u53F3\u4E0A\u89D2\u7684\u4E2A\u4EBA\u8D44\u6599\u56FE\u6807\u3002\n
      3. \u8FDB\u5165\u201C\u4ED8\u6B3E\u548C\u8BA2\u9605\u201D\u90E8\u5206\uFF0C\u7136\u540E\u9009\u62E9\u201C\u8BA2\u9605\u201D\u3002\n
