      Ads\t\u041D\u0435\u0442 \u0440\u0435\u043A\u043B\u0430\u043C\u044B\t\u0628\u062F\u0648\u0646
      \u0625\u0639\u0644\u0627\u0646\u0627\u062A\t\u0411\u0435\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u0438\tSense
