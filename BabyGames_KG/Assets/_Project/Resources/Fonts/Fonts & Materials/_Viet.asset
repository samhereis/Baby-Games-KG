      memnun musunuz?\t\u0412\u0430\u043C \u043F\u043E\u0434\u043E\u0431\u0430\u044E\u0442\u044C\u0441\u044F
      \u043D\u0430\u0448\u0456 \u0434\u043E\u0434\u0430\u0442\u043A\u0438?\tTh\xEDch
      \u1EE9ng d\u1EE5ng c\u1EE7a ch\xFAng t\xF4i?\nfor_parents_about_us_3_help_us\t39\tPlease
      help us to get better!\t\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u043D\u0430\u043C \u0441\u0442\u0430\u0442\u044C
      \u043B\u0443\u0447\u0448\u0435!\t\u0627\u0644\u0631\u062C\u0627\u0621 \u0645\u0633\u0627\u0639\u062F\u062A\u0646\u0627
      \u0639\u0644\u0649 \u0627\u0644\u062A\u062D\u0633\u0646!\t\u041C\u043E\u043B\u044F,
